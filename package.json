{
  "name": "openscad-mcp-server",
  "module": "./dist/index.js",
  "type": "module",
  "license": "MIT",
  "version": "0.0.0",
  "description": "An MCP server for rendering STL and PNG from OpenSCAD code.",
  "repository": {
    "url": "git+https://github.com/fboldo/openscad-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "openscad",
    "scad",
    "cad",
    "stl",
    "png",
    "3d"
  ],
  "scripts": {
    "start": "bun --watch index.ts",
    "dev": "bun x @modelcontextprotocol/inspector bun start --stdio",
    "build": "bun build index.ts --outdir dist --target node --format esm --production --banner '#!/usr/bin/env node\n'",
    "prepack": "bun run build"
  },
  "bin": {
    "openscad-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.2.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@scalenc/stl-to-png": "^1.2.0",
    "hono": "^4.11.9",
    "openscad-wasm": "^0.0.4",
    "zod": "^4.3.6"
  }
}
